<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build (not run) on macOS/Linux, e.g. for CI checks. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BeatRGB</AssemblyName>
    <RootNamespace>BeatRGB.Windows</RootNamespace>
    <ApplicationIcon>BeatRGB.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>BeatRGB</Product>
    <Description>Music- and screen-reactive keyboard lighting through OpenRGB</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BeatRGB.Core\BeatRGB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BeatRGB.ico" LogicalName="BeatRGB.ico" />
  </ItemGroup>

</Project>
